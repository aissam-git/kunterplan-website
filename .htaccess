# Nur falls der Webhost Apache/.htaccess unterstützt.
Options -Indexes

<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set X-Frame-Options "DENY"
 Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src 'none'; upgrade-insecure-requests"
 Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
 Header always set Cross-Origin-Opener-Policy "same-origin"
 Header always set X-Permitted-Cross-Domain-Policies "none"
 Header always set Strict-Transport-Security "max-age=31536000"
 Header always set Cache-Control "public, max-age=0, must-revalidate"
</IfModule>

<IfModule mod_headers.c>
 <FilesMatch "\.(png|webp|jpg|jpeg|svg|ico)$">
  Header set Cache-Control "public, max-age=604800"
 </FilesMatch>
 <FilesMatch "\.(css|js)$">
  Header set Cache-Control "public, max-age=86400"
 </FilesMatch>
</IfModule>
